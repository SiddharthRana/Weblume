# --- Server ---
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info

# --- Database (Supabase Postgres). Use the pooled connection string in production. ---
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres

# --- Supabase Auth ---
# Project URL, e.g. https://<project-ref>.supabase.co (local: http://127.0.0.1:54321)
SUPABASE_URL=http://127.0.0.1:54321
# Optional: legacy HS256 JWT secret. Leave empty to verify tokens via the project's JWKS (recommended).
SUPABASE_JWT_SECRET=

# --- Rate limiting (per IP) ---
RATE_LIMIT_PER_MINUTE=60
# Number of reverse proxies in front of the API (e.g. 1 behind Fly.io/Render). 0 = direct.
TRUST_PROXY_HOPS=0
