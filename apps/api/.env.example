# --- Server ---
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info

# --- Database (Supabase Postgres). Use the pooled connection string in production. ---
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres

# --- Supabase Auth ---
# Project URL, e.g. https://<project-ref>.supabase.co (local: http://127.0.0.1:54321)
SUPABASE_URL=http://127.0.0.1:54321
# Optional: legacy HS256 JWT secret. Leave empty to verify tokens via the project's JWKS (recommended).
SUPABASE_JWT_SECRET=

# --- Rate limiting (per IP) ---
RATE_LIMIT_PER_MINUTE=60
# Requests per minute per signed-in user, across all their IPs.
USER_RATE_LIMIT_PER_MINUTE=120
# Rate-limit counters: postgres (shared across instances; default in production) or memory.
# RATE_LIMIT_STORE=postgres
# Optional error reporting (Sentry). Personal data is scrubbed before sending. Empty = log only.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
# Enables GET /metrics (Prometheus text) with `Authorization: Bearer <token>`. 24+ chars. Empty = disabled.
METRICS_TOKEN=
# Number of reverse proxies in front of the API (e.g. 1 behind Fly.io/Render). 0 = direct.
TRUST_PROXY_HOPS=0

# --- Scanning ---
# Google PageSpeed Insights API key (free quota). Without it, reports say Lighthouse data is unavailable.
PSI_API_KEY=
PSI_CACHE_TTL_HOURS=6
# Public website URL, shown in the bot's User-Agent (WeblumeBot/1.0 (+<url>/bot)).
PUBLIC_SITE_URL=http://localhost:3000
SCAN_TIMEOUT_MS=90000
SCAN_PAGE_TIMEOUT_MS=10000
SCAN_PAGE_MAX_BYTES=5000000
SCAN_GLOBAL_CONCURRENCY=3
# Hostnames the scanner must never fetch, e.g. your API's own domain.
SCAN_BLOCKED_HOSTS=
# Run the scan worker inside the API process.
WORKER_ENABLED=true
# >= 32 random characters; used to hash guest IPs. Required in production. Generate: openssl rand -hex 32
GUEST_HASH_SECRET=
# Cloudflare Turnstile secret for guest scans. Required in production for guest scans.
TURNSTILE_SECRET_KEY=
# Stricter per-IP limit for starting/retrying scans.
SCAN_CREATE_RATE_LIMIT_PER_MINUTE=10

# --- Accounts ---
# Supabase secret key (sb_secret_… or legacy service_role). Server-only! Used to delete auth users when
# someone deletes their account. Without it, deletions remove app data immediately and the auth user is
# removed once the key is configured (or manually in the Supabase dashboard).
SUPABASE_SECRET_KEY=

# --- Billing (sandbox/test credentials only until launch; see docs/payments-setup.md) ---
# none | paddle | dodo — confirm seller eligibility for your country before choosing.
WEB_PAYMENT_PROVIDER=none
BILLING_RETURN_URL=http://localhost:3000/account?checkout=success
PADDLE_ENV=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_STARTER_MONTHLY=
PADDLE_PRICE_STARTER_ANNUAL=
DODO_ENV=test
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
DODO_PRODUCT_STARTER_MONTHLY=
DODO_PRODUCT_STARTER_ANNUAL=
GOOGLE_PLAY_PACKAGE_NAME=com.weblume.app
GOOGLE_PLAY_SUBSCRIPTION_ID=weblume_starter
# Service account key JSON (raw or base64). Server-only secret.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_RTDN_AUDIENCE=
GOOGLE_PLAY_RTDN_SERVICE_ACCOUNT=
# >= 32 random chars; HMAC key for the account id sent to Google Play. openssl rand -hex 32
BILLING_ACCOUNT_SECRET=
