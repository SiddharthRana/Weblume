  "info": {
    "title": "Weblume API",
    "description": "Website audit API. All routes require a Supabase access token unless noted.",
    "version": "1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "HealthDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          }
        },
        "required": [
          "status"
        ]
      },
      "EntitlementsDto": {
        "type": "object",
        "properties": {
          "scansPerPeriod": {
            "type": "integer"
          },
          "quotaPeriod": {
            "type": "string",
            "enum": [
              "day",
              "calendar_month",
              "billing_period"
            ]
          },
          "retentionDays": {
            "type": "integer"
          },
          "lighthouseData": {
            "type": "boolean"
          },
          "comparison": {
            "type": "boolean"
          },
          "pdfExport": {
            "type": "boolean"
          },
          "shareLinks": {
            "type": "boolean"
          }
        },
        "required": [
          "scansPerPeriod",
          "quotaPeriod",
          "retentionDays",
          "lighthouseData",
          "comparison",
          "pdfExport",
          "shareLinks"
        ]
      },
      "DisplayPriceDto": {
        "type": "object",
        "properties": {
          "currency": {
            "type": "string",
            "enum": [
              "INR",
              "USD"
            ]
          },
          "monthly": {
            "type": "integer",
            "description": "Monthly price in minor units (paise/cents)"
          },
          "annual": {
            "type": "integer",
            "description": "Annual price in minor units (paise/cents)"
          }
        },
        "required": [
          "currency",
          "monthly",
          "annual"
        ]
      },
      "PlanDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "guest",
              "free",
              "starter"
            ]
          },
          "name": {
            "type": "string"
          },
          "paid": {
            "type": "boolean"
          },
          "entitlements": {
            "$ref": "#/components/schemas/EntitlementsDto"
          },
          "displayPrices": {
            "description": "Indicative prices only; the charged amount comes from the payment provider.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DisplayPriceDto"
            }
          }
        },
        "required": [
          "id",
          "name",
          "paid",
          "entitlements"
        ]
      },
      "CreateScanBody": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "example": "example.com",
            "maxLength": 2048
          },
          "turnstileToken": {
            "type": "string",
            "description": "Cloudflare Turnstile token. Required for guest (signed-out) scans."
          }
        },
        "required": [
          "url"
        ]
      },
      "SeverityCountsDto": {
        "type": "object",
        "properties": {
          "critical": {
            "type": "integer"
          },
          "high": {
            "type": "integer"
          },
          "medium": {
            "type": "integer"
          },
          "low": {
            "type": "integer"
          },
          "info": {
            "type": "integer"
          }
        }
      },
      "ScanSummaryDtoClass": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "targetUrl": {
            "type": "string"
          },
          "normalizedUrl": {
            "type": "string"
          },
          "finalUrl": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "completed",
              "partial",
              "failed"
            ]
          },
          "failureCode": {
            "type": "string",
            "enum": [
              "invalid_url",
              "blocked_destination",
              "dns_failure",
              "connection_failed",
              "tls_error",
              "timeout",
              "too_many_redirects",
              "response_too_large",
              "not_html",
              "http_error",
              "internal_error",
              "scan_timeout"
            ],
            "nullable": true
          },
          "failureMessage": {
            "type": "string",
            "nullable": true
          },
          "severityCounts": {
            "$ref": "#/components/schemas/SeverityCountsDto"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "completedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        },
        "required": [
          "id",
          "targetUrl",
          "normalizedUrl",
          "finalUrl",
          "status",
          "failureCode",
          "failureMessage",
          "severityCounts",
          "createdAt",
          "completedAt"
        ]
      },
      "CreateScanResponse": {
        "type": "object",
        "properties": {
          "scan": {
            "$ref": "#/components/schemas/ScanSummaryDtoClass"
          },
          "scanToken": {
            "type": "string",
            "description": "Guest scans only: secret required to view the scan (send as X-Scan-Token). Shown once."
          },
          "deduplicated": {
            "type": "boolean",
            "description": "True when an identical recent scan was returned instead of starting a new one"
          }
        },
        "required": [
          "scan",
          "deduplicated"
        ]
      },
      "ApiErrorDto": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "integer"
          },
          "code": {
            "type": "string",
            "example": "quota_exceeded"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "statusCode",
          "code",
          "message"
        ]
      },
      "ScanListResponse": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ScanSummaryDtoClass"
            }
          },
          "nextCursor": {
            "type": "string",
            "nullable": true,
            "format": "date-time"
          }
        },
        "required": [
          "items",
          "nextCursor"
        ]
      },
      "SourceStatusDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "skipped",
              "failed"
            ]
          },
          "reason": {
            "type": "string",
            "enum": [
              "not_configured",
              "disabled",
              "not_applicable",
              "timeout",
              "quota_exceeded",
              "upstream_error",
              "blocked",
              "invalid_response"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "ScanSourcesDto": {
        "type": "object",
        "properties": {
          "page_fetch": {
            "$ref": "#/components/schemas/SourceStatusDto"
          },
          "psi_mobile": {
            "$ref": "#/components/schemas/SourceStatusDto"
          },
          "psi_desktop": {
            "$ref": "#/components/schemas/SourceStatusDto"
          },
          "link_check": {
            "$ref": "#/components/schemas/SourceStatusDto"
          },
          "robots_sitemap": {
            "$ref": "#/components/schemas/SourceStatusDto"
          }
        }
      },
      "LighthouseScoresDto": {
        "type": "object",
        "properties": {
          "performance": {
