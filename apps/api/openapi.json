            "type": "string"
          },
          "whatItMeans": {
            "type": "string"
          },
          "whyItMatters": {
            "type": "string"
          },
          "howToFix": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "learnMoreUrl": {
            "type": "string"
          },
          "details": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": [
          "id",
          "checkId",
          "category",
          "severity",
          "kind",
          "source",
          "title",
          "whatItMeans",
          "whyItMatters",
          "howToFix",
          "details"
        ]
      },
      "ScanReportDtoClass": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "targetUrl": {
            "type": "string"
          },
          "normalizedUrl": {
            "type": "string"
          },
          "finalUrl": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "completed",
              "partial",
              "failed"
            ]
          },
          "failureCode": {
            "type": "string",
            "enum": [
              "invalid_url",
              "blocked_destination",
              "dns_failure",
              "connection_failed",
              "tls_error",
              "timeout",
              "too_many_redirects",
              "response_too_large",
              "not_html",
              "http_error",
              "internal_error",
              "scan_timeout"
            ],
            "nullable": true
          },
          "failureMessage": {
            "type": "string",
            "nullable": true
          },
          "severityCounts": {
            "$ref": "#/components/schemas/SeverityCountsDto"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "completedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "sources": {
            "description": "Outcome of each data source",
            "allOf": [
              {
                "$ref": "#/components/schemas/ScanSourcesDto"
              }
            ]
          },
          "lighthouse": {
            "nullable": true,
            "description": "Lighthouse results from Google PageSpeed Insights; null when unavailable",
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/LighthouseByStrategyDto"
              }
            ]
          },
          "passedChecks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "findings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FindingDtoClass"
            }
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "targetUrl",
          "normalizedUrl",
          "finalUrl",
          "status",
          "failureCode",
          "failureMessage",
          "severityCounts",
          "createdAt",
          "completedAt",
          "sources",
          "lighthouse",
          "passedChecks",
          "findings",
          "expiresAt"
        ]
      },
