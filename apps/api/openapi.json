          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "low",
              "info"
            ]
          },
          "kind": {
            "type": "string",
            "enum": [
              "measured",
              "detected",
              "recommendation"
            ]
          },
          "source": {
            "type": "string",
            "enum": [
              "page_fetch",
              "psi_mobile",
              "psi_desktop",
              "link_check",
              "robots_sitemap"
            ]
