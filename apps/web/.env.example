# Public site URL (used for canonical URLs, sitemap, Open Graph). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Weblume API base URL.
NEXT_PUBLIC_API_URL=http://localhost:4000
# Shown on the contact page and legal pages.
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
# Cloudflare Turnstile site key for guest scans (leave empty in local dev).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Supabase project URL and publishable (anon) key. Leave empty to run without accounts (guest scans only).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Show "Continue with Google" (requires the Google provider enabled in Supabase Auth).
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false
