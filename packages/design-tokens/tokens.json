{
  "$description": "Single source of truth for Weblume design tokens. Run `pnpm tokens` after editing to regenerate CSS, TS and Dart outputs.",
  "color": {
    "light": {
      "background": "#F7F8FB",
      "surface": "#FFFFFF",
      "surfaceMuted": "#EEF1F6",
      "border": "#D5DBE5",
      "text": "#111827",
      "textMuted": "#4B5565",
      "primary": "#2448D8",
      "primaryHover": "#1B39B3",
      "onPrimary": "#FFFFFF",
      "accent": "#F2A516",
      "onAccent": "#1F1400",
      "focus": "#2448D8",
      "success": "#0F7A3D",
      "danger": "#B42318"
    },
    "dark": {
      "background": "#0B1020",
      "surface": "#121A2E",
      "surfaceMuted": "#1A2440",
      "border": "#2B3756",
      "text": "#F1F4FA",
      "textMuted": "#A9B4C8",
      "primary": "#7D98FF",
      "primaryHover": "#9DB1FF",
      "onPrimary": "#0B1020",
      "accent": "#F5B84A",
      "onAccent": "#1F1400",
      "focus": "#9DB1FF",
      "success": "#4ADE80",
      "danger": "#F97066"
    }
  },
  "severity": {
    "light": {
      "critical": { "fg": "#9F1A13", "bg": "#FDECEA" },
      "high": { "fg": "#A2360B", "bg": "#FDEEE4" },
      "medium": { "fg": "#8A5300", "bg": "#FEF4DC" },
      "low": { "fg": "#1F4FB8", "bg": "#E8EFFD" },
      "info": { "fg": "#404B5C", "bg": "#EEF1F6" }
    },
    "dark": {
      "critical": { "fg": "#FFA39B", "bg": "#3A1513" },
      "high": { "fg": "#FDB48A", "bg": "#3A2012" },
      "medium": { "fg": "#FBD27A", "bg": "#382A0E" },
      "low": { "fg": "#A8C1FF", "bg": "#172648" },
      "info": { "fg": "#C3CCDB", "bg": "#1F2A42" }
    }
  },
  "font": {
    "family": {
      "sans": "Inter",
      "mono": "JetBrains Mono"
    },
    "size": {
      "xs": 12,
      "sm": 14,
      "md": 16,
      "lg": 18,
      "xl": 22,
      "2xl": 28,
      "3xl": 36,
      "4xl": 48
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "lineHeight": {
      "tight": 1.2,
      "normal": 1.5
    }
  },
  "space": {
    "0": 0,
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 20,
    "6": 24,
    "8": 32,
    "10": 40,
    "12": 48,
    "16": 64
  },
  "radius": {
    "sm": 6,
    "md": 10,
    "lg": 16,
    "full": 9999
  }
}
